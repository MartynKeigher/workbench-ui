{
  "name": "@martynkeigher/workbench-ui",
  "version": "0.1.0",
  "description": "A calm, dense UI kit for tool-style web apps: design tokens with light and dark palettes, a header bar, tabs and toasts. Plain JavaScript and CSS, no framework, no build step.",
  "keywords": [
    "design system",
    "ui",
    "components",
    "css custom properties",
    "design tokens",
    "dark mode",
    "vanilla js"
  ],
  "author": "Martyn Keigher (https://github.com/MartynKeigher)",
  "repository": "https://github.com/MartynKeigher/workbench-ui.git",
  "homepage": "https://github.com/MartynKeigher/workbench-ui",
  "bugs": {
    "url": "https://github.com/MartynKeigher/workbench-ui/issues"
  },
  "license": "MIT",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./toast": "./src/components/toast/toast.js",
    "./tabs": "./src/components/tabs/tabs.js",
    "./color-mode": "./src/components/color-mode/color-mode.js",
    "./workbench.css": "./src/workbench.css",
    "./fonts.css": "./src/fonts.css",
    "./tokens.css": "./src/tokens.css",
    "./base.css": "./src/base.css",
    "./header.css": "./src/header.css",
    "./toast.css": "./src/components/toast/toast.css",
    "./tabs.css": "./src/components/tabs/tabs.css",
    "./package.json": "./package.json"
  },
  "files": [
    "src"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "dev": "vite --open /demo/",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.10",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
